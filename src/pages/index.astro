---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (value = "") => {
  const normalized = value.replace(/^\/+/, "");
  return normalized ? `${base}${normalized}` : base;
};
---

<BaseLayout title="Home" description="Portfolio and technical notes by Leo">
  <section class="hero">
    <p class="kicker">Security Engineer / Red Teamer</p>
    <h1 class="title">Welcome to this Page</h1>
    <p class="desc">
      ようこそ本サイトへ！趣味、技術的なことは、はてなブログに投稿していっているので、是非読んでいってね
    </p>
    <div class="hero-actions">
      <a class="button primary" href={withBase("about/")}>プロフィールを見る</a>
      <a class="button ghost" href={withBase("blog/")}>ブログ</a>
    </div>
  </section>

  <div class="grid">
    <section class="card list col-8">
      <h2>Blog</h2>
      <p class="meta">はてなブログで趣味、技術（主にセキュリティ）に関する記事を書いています。</p>
      <div class="blog-cta">
        <a
          class="button primary"
          href="https://nyleon.hatenablog.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          はてなブログを読む →
        </a>
        <a class="button ghost" href={withBase("blog/")}>記事一覧（RSS）</a>
      </div>
    </section>

    <aside class="card note col-4">
      <h2>Now</h2>
      <p>
        最近はEDRの検知ロジックと回避の検証、テレメトリからの痕跡分析を中心に。<br />
        技術も筋肉も、少しずつ積み上げ中。目指せベンチ100kg💪
      </p>
      <h2>Links</h2>
      <ul class="linklist">
        <li>
          <a
            class="icon-link"
            href="https://www.linkedin.com/in/玲央-北山-6319a42bb"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span class="sr-only">LinkedIn</span>
          </a>
        </li>
        <li>
          <a
            class="icon-link"
            href="https://x.com/Nyleon88"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (formerly Twitter)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M18.244 2h3.308l-7.226 8.26L22.82 22h-6.65l-5.2-6.8L4.98 22H1.67l7.73-8.835L1.254 2h6.82l4.7 6.23L18.244 2zm-1.161 18h1.833L7.084 3.89H5.117L17.083 20z"
              ></path>
            </svg>
            <span class="sr-only">X</span>
          </a>
        </li>
        <li>
          <a
            class="icon-link"
            href="https://github.com/Nylon88"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span class="sr-only">GitHub</span>
          </a>
        </li>
      </ul>
      <h2>Contact</h2>
      <p class="meta">Discord: Nyleon88#6315</p>
    </aside>
  </div>
</BaseLayout>

<style>
  .blog-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
</style>
