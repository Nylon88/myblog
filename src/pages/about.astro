---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (value = "") => {
  const normalized = value.replace(/^\/+/, "");
  return normalized ? `${base}${normalized}` : base;
};
---

<BaseLayout title="About" description="Profile of Leo Kitayama (Nyleon) — Red Team Security Engineer">
  <section class="about-simple">
    <div class="about-simple-photo">
      <img
        src={withBase("images/header-cat.jpg")}
        alt="Profile photo"
        width="220"
        height="220"
        class="about-photo"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="about-simple-copy">
      <h1>My Profile</h1>
      <p class="about-simple-lead">Leo Kitayama (a.k.a Nyleon)</p>
      <p class="about-simple-text">
        セキュリティベンダーにてRed Teamエンジニアとして従事。
        脆弱性診断・ペネトレーションテストを主軸に、デジタルフォレンジックやマルウェア解析まで幅広く経験。
        攻撃者視点でシステムの堅牢性を評価し、実践的なセキュリティ改善を支援しています。
      </p>
      <ul class="about-social">
        <li>
          <a
            href="https://www.linkedin.com/in/玲央-北山-6319a42bb"
            target="_blank"
            rel="noopener noreferrer"
            class="about-social-link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
              <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </li>
        <li>
          <a
            href="https://x.com/Nyleon88"
            target="_blank"
            rel="noopener noreferrer"
            class="about-social-link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
              <path fill="currentColor" d="M18.244 2h3.308l-7.226 8.26L22.82 22h-6.65l-5.2-6.8L4.98 22H1.67l7.73-8.835L1.254 2h6.82l4.7 6.23L18.244 2zm-1.161 18h1.833L7.084 3.89H5.117L17.083 20z"/>
            </svg>
            X (Twitter)
          </a>
        </li>
        <li>
          <a
            href="https://github.com/Nylon88"
            target="_blank"
            rel="noopener noreferrer"
            class="about-social-link"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
              <path fill="currentColor" d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
          </a>
        </li>
      </ul>
    </div>
  </section>

  <div class="about-sections">
    <section class="card about-card">
      <h2>Experience</h2>
      <div class="exp-item">
        <div class="exp-meta">
          <span class="exp-badge">現職</span>
          <span class="exp-role">Red Team</span>
        </div>
        <p class="exp-company">セキュリティベンダー</p>
        <ul class="exp-list">
          <li>Webアプリ・ネットワーク・クラウド環境を対象とした脆弱性診断</li>
          <li>TLPT（脅威ベースのペネトレーションテスト）を含むペネトレーションテストの立案・実施</li>
          <li>IR,デジタルフォレンジック</li>
          <li>マルウェア解析・EDR検知ロジックの研究と回避手法の検証</li>
        </ul>
      </div>
    </section>

    <section class="card about-card">
      <h2>Skills</h2>
      <div class="skills-grid">
        <div class="skill-group">
          <h3 class="skill-group-label">Offensive Security</h3>
          <div class="skill-pills">
            <span class="skill-pill">Penetration Testing</span>
            <span class="skill-pill">Red Teaming</span>
            <span class="skill-pill">TLPT</span>
            <span class="skill-pill">Vulnerability Assessment</span>
          </div>
        </div>
        <div class="skill-group">
          <h3 class="skill-group-label">Malware &amp; Forensics</h3>
          <div class="skill-pills">
            <span class="skill-pill">Malware Analysis</span>
            <span class="skill-pill">EDR Evasion</span>
            <span class="skill-pill">Digital Forensics</span>
          </div>
        </div>
        <div class="skill-group">
          <h3 class="skill-group-label">Technical</h3>
          <div class="skill-pills">
            <span class="skill-pill">Windows Internals</span>
            <span class="skill-pill">Active Directory</span>
            <span class="skill-pill">Network Security</span>
            <span class="skill-pill">Cloud Security</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-social {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .about-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.32rem 0.8rem 0.32rem 0.6rem;
    background: rgba(255, 255, 255, 0.6);
    transition: border-color 180ms ease, background 180ms ease, color 180ms ease;
  }

  .about-social-link:hover {
    color: var(--ink);
    border-color: rgba(var(--accent), 0.35);
    background: rgba(var(--accent), 0.09);
  }

  .about-sections {
    margin-top: 1rem;
    display: grid;
    gap: 1rem;
  }

  .about-card {
    padding: 1.4rem 1.5rem;
  }

  .about-card h2 {
    margin-top: 0;
    font-size: 1.25rem;
  }

  .exp-item {
    margin-top: 0.6rem;
  }

  .exp-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.2rem;
  }

  .exp-badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: rgba(var(--accent), 0.12);
    color: rgb(var(--accent));
    border: 1px solid rgba(var(--accent), 0.28);
  }

  .exp-role {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .exp-company {
    margin: 0 0 0.7rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .exp-list {
    margin: 0;
    padding-left: 1.2rem;
    color: rgba(37, 32, 25, 0.9);
    font-size: 0.95rem;
  }

  .exp-list li {
    margin-bottom: 0.45rem;
    line-height: 1.7;
  }

  .skills-grid {
    display: grid;
    gap: 1.1rem;
    margin-top: 0.5rem;
  }

  .skill-group-label {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    margin: 0 0 0.55rem;
  }

  .skill-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-pill {
    font-size: 0.84rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--accent), 0.25);
    background: rgba(var(--accent), 0.07);
    color: rgb(102, 58, 42);
  }
</style>
